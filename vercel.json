{
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "core.py",
          "i18n.py",
          "main.py",
          "telegram_bot.py",
          "accounts_bot.py",
          "login_bot.py",
          "login_guard.py",
          "grade.py",
          "grade_bot.py",
          "deadline_bot.py",
          "moodle.py",
          "rooms.py",
          "rooms_bot.py",
          "events_bot.py",
          "announcements.py",
          "announcements_bot.py",
          "documents.py",
          "documents_bot.py",
          "doc_check.py",
          "assistant.py",
          "assistant_bot.py",
          "academic_calendar.py",
          "data/*.json",
          "locales/*.json",
          "static/**",
          "knowledge/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "crons": [{"path": "/api/announcements/notify", "schedule": "0 4 * * *"}]
}
