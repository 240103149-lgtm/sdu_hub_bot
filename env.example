# Copy this file to ".env" (with the dot) next to main.py and fill it in:
#   cp env.example .env
# Never commit .env to git.

# ---- AI model (required) --------------------------------------------------
# Who answers the students: gemini, deepseek or openai. Several, comma-
# separated, are tried in order - "gemini,deepseek" means Gemini first, and
# DeepSeek whenever Gemini is rate-limited, overloaded or unreachable.
# Only the providers listed here need a key.
AI_PROVIDER=gemini

# Gemini - key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_from_aistudio_google_com
GEMINI_MODEL=gemini-flash-latest
# Optional: used automatically when the main model is overloaded (503).
GEMINI_FALLBACK_MODEL=

# DeepSeek - key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_FALLBACK_MODEL=

# OpenAI - or any other API in OpenAI's format (OpenRouter, Groq, a local
# Ollama...): set OPENAI_BASE_URL to it, e.g. https://openrouter.ai/api/v1
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

# Advanced: <NAME>_EXTRA_BODY is JSON added to every request of an
# OpenAI-format provider. DeepSeek answers without "thinking" by default
# (faster); to let it think - smarter, but slower:
#   DEEPSEEK_EXTRA_BODY={"thinking": {"type": "enabled"}}

# ---- Telegram (required for the bot) --------------------------------------
# Get the token from @BotFather in Telegram: /newbot
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenFromBotFather

# "off"      - main.py serves only the website (default)
# "webhook"  - main.py also serves the bot; needs an HTTPS domain
TELEGRAM_MODE=off
TELEGRAM_WEBHOOK_URL=
# Any random string. Telegram sends it back in a header so nobody else can
# post fake updates to your webhook.
TELEGRAM_WEBHOOK_SECRET=

# ---- Optional -------------------------------------------------------------
# Shown as a button under /guide (US3: "provide the university portal link").
REGISTRATION_PORTAL_URL=

# US5 timing. SLOW_RESPONSE_SECONDS is the target every answer is measured
# against and logged in the terminal; RESPONSE_BUDGET_SECONDS is the hard
# cut-off after which the student sees an error instead of waiting.
SLOW_RESPONSE_SECONDS=5
RESPONSE_BUDGET_SECONDS=20
# Per request to the AI (the older name GEMINI_TIMEOUT_SECONDS works too).
AI_TIMEOUT_SECONDS=15
