# Copy this file to ".env" (with the dot) next to main.py and fill it in:
#   cp env.example .env
# Never commit .env to git.

# ---- AI model (required) --------------------------------------------------
# gemini (default) or deepseek. The AI assistant calls the bot's services as
# tools with either of them.
AI_PROVIDER=gemini

GEMINI_API_KEY=your_key_from_aistudio_google_com
GEMINI_MODEL=gemini-flash-latest
# Optional: used automatically when the main model is overloaded (503). Pick a
# model that still exists - e.g. gemini-flash-lite-latest; gemini-2.5-flash-lite
# answers 404 "no longer available" since autumn 2026.
GEMINI_FALLBACK_MODEL=

# Only when AI_PROVIDER=deepseek. Key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# ---- Telegram (required for the bot) --------------------------------------
# Get the token from @BotFather in Telegram: /newbot
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenFromBotFather

# "off"      - main.py serves only the website (default)
# "webhook"  - main.py also serves the bot; needs an HTTPS domain
TELEGRAM_MODE=off
TELEGRAM_WEBHOOK_URL=
# Any random string. Telegram sends it back in a header so nobody else can
# post fake updates to your webhook.
TELEGRAM_WEBHOOK_SECRET=

# ---- Optional -------------------------------------------------------------
# Shown as a button under /guide (US2: "provide the registration portal link").
# Empty: https://my.sdu.edu.kz/
REGISTRATION_PORTAL_URL=

# Chatbot timing (US1: "a response within 5 seconds"). SLOW_RESPONSE_SECONDS
# is the target every answer is measured against and logged in the terminal;
# after RESPONSE_BUDGET_SECONDS the bot stops waiting and shows
# "Connection error". Raise the budget only if your model can't answer in 5 s.
SLOW_RESPONSE_SECONDS=5
RESPONSE_BUDGET_SECONDS=5
GEMINI_TIMEOUT_SECONDS=6

# ---- Sign-in protection (US7) --------------------------------------------
# After LOGIN_MAX_FAILURES wrong passwords in a row, signing in to that
# account through the bot is locked for LOGIN_LOCK_MINUTES. Every sign-in is
# timed against LOGIN_TARGET_SECONDS in the terminal log.
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
LOGIN_TARGET_SECONDS=3

# ---- Moodle deadlines -----------------------------------------------------
MOODLE_BASE_URL=https://moodle.sdu.edu.kz
MOODLE_TIMEOUT_SECONDS=15
BOT_TIMEZONE=Asia/Almaty

# Public website link to your Telegram bot (no token).
TELEGRAM_PUBLIC_URL=https://t.me/sdu_hub_bot
# Fetch only the anonymous public SDU Life homepage. Set off for offline demos.
CAMPUS_EVENTS_LIVE=on
# Class (15 min) and Moodle deadline (12 h) reminders. "off" stops them.
# - Persistent host (python bot.py, or uvicorn outside Vercel): a minute job
#   checks by itself; keep bot_state.pickle on a durable disk (BOT_STATE_PATH).
# - Vercel: no timer survives there. Connect a Redis database (Vercel ->
#   Storage -> Upstash for Redis -> Connect Project; it sets KV_REST_API_URL
#   and KV_REST_API_TOKEN by itself) and redeploy. The bot then keeps each
#   student's settings in Redis (encrypted), and
#   .github/workflows/reminders.yml calls /api/cron/reminders every 5 minutes.
REMINDERS_ENABLED=on
# Optional: the same random value here (Vercel) and as the GitHub Actions
# secret CRON_SECRET; then only that workflow can start a reminder check.
CRON_SECRET=
# Redis REST database for the bot state, if not set by the Vercel integration
# (KV_REST_API_* or UPSTASH_REDIS_REST_* or SDU_OAUTH_REDIS_* also work).
BOT_STATE_REDIS_URL=
BOT_STATE_REDIS_TOKEN=
# On a persistent host, point this at a mounted durable volume.
# Example: /var/data/bot_state.pickle. Empty: original default location.
BOT_STATE_PATH=
# Optional independent encryption secret for website sessions. Use a long
# random value. Empty: derive a separate key from TELEGRAM_BOT_TOKEN.
WEB_SESSION_SECRET=

# ---- Document submission (US8) --------------------------------------------
# Telegram user IDs of the admissions staff who verify submitted documents,
# separated by commas (each of them must press /start in the bot once).
# Empty: submitted documents simply stay "under review".
DOCUMENTS_REVIEWER_IDS=
# Where the table of submitted documents is kept. Default: data/documents.db
# (on Vercel: /tmp/documents.db, which is wiped between cold starts).
DOCUMENTS_DB_PATH=

# AI check that an uploaded file IS the requested document (passport vs
# timetable, unreadable photo...). Needs GEMINI_API_KEY (DeepSeek has no image
# input). Only the document TYPE is asked for: nothing read from the file is
# returned, stored or logged. "off" = check the format and size only.
DOCUMENT_CHECK=on
# Empty: GEMINI_MODEL, then GEMINI_FALLBACK_MODEL.
DOCUMENT_CHECK_MODEL=
# All attempts together; if the model is still not reachable, the file is
# kept and the admissions office checks it by hand.
DOCUMENT_CHECK_SECONDS=30

# SDU Platform OAuth: public client_id/callback defaults are in sdu_oauth_client.json.
# The provider handles the student's SDU password and any 2FA itself.
SDU_OAUTH_CLIENT_ID=
SDU_OAUTH_REDIRECT_URI=https://sdu-hub-bot.vercel.app/api/me/sdu/callback
# Vercel REQUIRES a durable Redis REST store. Set these privately in Vercel;
# do not put a token into GitHub or a chat. Token records are encrypted at rest.
# Empty: the same database as the bot state (KV_REST_API_* etc.) is used.
SDU_OAUTH_REDIS_URL=
SDU_OAUTH_REDIS_TOKEN=
# Persistent server / local development only. Vercel never uses a /tmp fallback.
SDU_OAUTH_DB_PATH=
