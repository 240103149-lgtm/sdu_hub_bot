# Copy this file to ".env" (with the dot) next to main.py and fill it in:
#   cp env.example .env
# Never commit .env to git.

# ---- Gemini (required) ----------------------------------------------------
GEMINI_API_KEY=your_key_from_aistudio_google_com
GEMINI_MODEL=gemini-flash-latest
# Optional: used automatically when the main model is overloaded (503).
GEMINI_FALLBACK_MODEL=

# ---- Telegram (required for the bot) --------------------------------------
# Get the token from @BotFather in Telegram: /newbot
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenFromBotFather

# "off"      - main.py serves only the website (default)
# "webhook"  - main.py also serves the bot; needs an HTTPS domain
TELEGRAM_MODE=off
TELEGRAM_WEBHOOK_URL=
# Any random string. Telegram sends it back in a header so nobody else can
# post fake updates to your webhook.
TELEGRAM_WEBHOOK_SECRET=

# ---- Optional -------------------------------------------------------------
# Shown as a button under /guide (US2: "provide the registration portal link").
# Empty: https://my.sdu.edu.kz/
REGISTRATION_PORTAL_URL=

# Chatbot timing (US1: "a response within 5 seconds"). SLOW_RESPONSE_SECONDS
# is the target every answer is measured against and logged in the terminal;
# after RESPONSE_BUDGET_SECONDS the bot stops waiting and shows
# "Connection error". Raise the budget only if your model can't answer in 5 s.
SLOW_RESPONSE_SECONDS=5
RESPONSE_BUDGET_SECONDS=5
GEMINI_TIMEOUT_SECONDS=6

# ---- Sign-in protection (US7) --------------------------------------------
# After LOGIN_MAX_FAILURES wrong passwords in a row, signing in to that
# account through the bot is locked for LOGIN_LOCK_MINUTES. Every sign-in is
# timed against LOGIN_TARGET_SECONDS in the terminal log.
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
LOGIN_TARGET_SECONDS=3

# ---- Moodle deadlines -----------------------------------------------------
MOODLE_BASE_URL=https://moodle.sdu.edu.kz
MOODLE_TIMEOUT_SECONDS=15
BOT_TIMEZONE=Asia/Almaty

# ---- Document submission (US8) --------------------------------------------
# Telegram user IDs of the admissions staff who verify submitted documents,
# separated by commas (each of them must press /start in the bot once).
# Empty: submitted documents simply stay "under review".
DOCUMENTS_REVIEWER_IDS=
# Where the table of submitted documents is kept. Default: data/documents.db
# (on Vercel: /tmp/documents.db, which is wiped between cold starts).
DOCUMENTS_DB_PATH=
